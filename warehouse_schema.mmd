    GENES {
        string gene_id PK
        string mutation_class
        float stability_index
    }

    GENE_REGULATION {
        string source_gene_id FK
        string target_gene_id
        string effect
    }

    POWERS {
        string power_id PK
        string power_name
        string description
    }
    
    GENE_SEEDS {
        string gene_id FK
        string seed_name
    }
    
    GENE_SIDE_EFFECTS {
        string gene_id FK
        string side_effect_name
    }

    %% Cross-Domain Relationships
    HERO_GENES }|--|| GENES : "instance_of"
    HERO_GENE_REGULATION }|--|| GENES : "targets"
    
